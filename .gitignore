# runtime student data — never in git, and on the server it lives OUTSIDE
# the repo entirely (NTGEN_DATA_DIR) so a redeploy can't touch it
data/

.DS_Store
__pycache__/
*.pyc
.claude/
*.md

# curriculum.md is NOT a doc — it is runtime data. app.py calls
# load_curriculum() at import, so a checkout without it cannot boot. It was
# already lost once to the *.md rule above; keep these exceptions.
!backend/ntgen/curriculum.md
!README.md
