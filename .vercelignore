# vercel.json uses includeFiles "**" so no data file is ever missed from the
# bundle. That makes this file the guard on the other side: real student data
# and local notes must never be uploaded.
#
# .gitignore already covers these for git, and the CLI honours it, but a
# `vercel deploy` from this laptop bundles the working tree — not the commit —
# so data/ has to be excluded here explicitly.
data/
.claude/
__pycache__/
*.pyc
.DS_Store
.git/
